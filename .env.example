# ============================================================
#  PANEL RADIO ONLINE — Variables de entorno (PRODUCCIÓN / VPS)
#  Copia este archivo a ".env" en el VPS y rellena los valores.
#      cp .env.example .env && nano .env
#  El archivo .env NO se sube a Git (está en .gitignore).
# ============================================================

# --- Entorno ---
# OBLIGATORIO en producción. Activa protecciones de seguridad:
# CORS cerrado, JWT_SECRET obligatorio, WebSocket autenticado.
NODE_ENV=production

# --- Dominio y HTTPS (Caddy obtiene el certificado SSL automáticamente) ---
# Apunta el registro DNS tipo A de este dominio a la IP de tu VPS.
DOMINIO=panel.tudominio.com
# Correo para los avisos del certificado Let's Encrypt.
EMAIL_SSL=tucorreo@ejemplo.com

# --- Seguridad del panel ---
# OBLIGATORIO: Clave para firmar los tokens de sesión. Usa algo largo y aleatorio:
#   openssl rand -hex 32
JWT_SECRET=
# Token para proteger el webhook de WhatsApp (opcional pero recomendado).
WEBHOOK_TOKEN=
# Contraseña del usuario "admin" la PRIMERA vez que se crea la base de datos.
# IMPORTANTE: Cámbiala antes del primer arranque. Después solo se puede cambiar
# desde el panel (Configuración → Contraseña del panel).
ADMIN_PASSWORD=
# Usuario admin (opcional, por defecto "admin").
ADMIN_USER=admin

# --- CORS: OBLIGATORIO en producción ---
# Restringe qué dominios pueden hacer requests a tu API.
# Usa la URL exacta de tu panel (sin slash final).
# Para múltiples dominios, sepáralos con coma: https://dominio1.com,https://dominio2.com
CORS_ORIGIN=https://panel.tudominio.com

# --- URL pública del stream que escuchan los oyentes ---
# Caster.fm (actual) o, si usas el Icecast propio del VPS, tu dominio de stream.
STREAM_URL=https://sapircast.caster.fm:13721/D6md9

# --- AzuraCast (opcional, recomendado en el VPS) ---
# Al instalar AzuraCast en el VPS, define estas dos variables y el panel
# mostrará "ahora suena", oyentes e historial 100% REALES automáticamente.
#   AZURACAST_BASE_URL = https://radio.tudominio.com
#   AZURACAST_STATION  = shortcode de tu estación (ej. eternal_beat)
AZURACAST_BASE_URL=
AZURACAST_STATION=

# --- Base de datos y archivos ---
# Ruta donde se guarda la base de datos SQLite.
# DB_PATH=/var/data/panel.db
# Ruta donde se guardan los archivos subidos (samples, canciones).
# UPLOADS_DIR=/var/data/uploads

# ============================================================
#  Solo si emites con NUESTRO Icecast/Liquidsoap en el VPS
#  (perfil "radio" de docker-compose.prod.yml)
# ============================================================
# Contraseña "source" del Icecast (la del icecast.xml). Cámbiala.
ICECAST_SOURCE_PASSWORD=
# Si en vez de Icecast propio emites a Caster.fm con Liquidsoap:
CASTER_PASSWORD=
