# Puerto del servidor API
PORT=4000

# Clave secreta para firmar los tokens JWT (cámbiala en producción)
JWT_SECRET=cambia-esta-clave-en-produccion

# Tiempo de expiración del token
JWT_EXPIRA=8h

# Ruta del archivo de base de datos SQLite (opcional)
DB_PATH=./data/panel.db

# Usuario y contraseña del admin al crear la BD por primera vez
ADMIN_USER=admin
ADMIN_PASSWORD=admin123

# Restringe CORS a uno o varios orígenes (separados por coma). Vacío = permitir todos (solo dev)
CORS_ORIGIN=

# Token para proteger el webhook de WhatsApp (si se define, exige ?token=... en la URL)
WEBHOOK_TOKEN=
