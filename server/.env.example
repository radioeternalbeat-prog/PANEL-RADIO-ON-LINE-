# Puerto del servidor API
PORT=4000

# Clave secreta para firmar los tokens JWT (cámbiala en producción)
JWT_SECRET=cambia-esta-clave-en-produccion

# Tiempo de expiración del token
JWT_EXPIRA=8h

# Ruta del archivo de base de datos SQLite (opcional)
DB_PATH=./data/panel.db

# Carpeta donde se guardan los audios subidos (samples/música)
UPLOADS_DIR=./data/uploads

# Usuario y contraseña del admin al crear la BD por primera vez
ADMIN_USER=admin
ADMIN_PASSWORD=admin123

# Restringe CORS a uno o varios orígenes (separados por coma). Vacío = permitir todos (solo dev)
CORS_ORIGIN=

# Token para proteger el webhook de WhatsApp (si se define, exige ?token=... en la URL)
WEBHOOK_TOKEN=

# Integración con Rekordbox (opcional):
# Carpeta local donde Rekordbox guarda tu música (la misma que ves en
# Rekordbox > Preferencias > Avanzado > Base de datos > Ubicación de la música).
# Si se define, el panel podrá REPRODUCIR los archivos importados desde el
# XML de Rekordbox (Archivo > Biblioteca > Exportar colección en formato xml).
# Solo funciona si el backend corre en la MISMA máquina donde está esa carpeta.
# Deja vacío para importar solo los metadatos (título, artista, BPM, etc.)
# sin poder reproducir el audio real.
REKORDBOX_MUSIC_ROOT=
