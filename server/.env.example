# ============================================================
#  PANEL RADIO ONLINE — Variables de entorno del SERVIDOR
#  Copia a .env en la carpeta /server para desarrollo local:
#      cp .env.example .env
# ============================================================

# Entorno: "development" o "production"
# En producción: JWT_SECRET es obligatorio, CORS se cierra, WebSocket requiere auth.
NODE_ENV=development

# Puerto del servidor API
PORT=4000

# OBLIGATORIO en producción. Clave secreta para firmar tokens JWT.
# Genera una con: openssl rand -hex 32
JWT_SECRET=

# Tiempo de expiración del token (default: 8h)
JWT_EXPIRA=8h

# Ruta del archivo de base de datos SQLite (opcional)
DB_PATH=./data/panel.db

# Carpeta donde se guardan los audios subidos (samples/música)
UPLOADS_DIR=./data/uploads

# Usuario y contraseña del admin al crear la BD por primera vez.
# IMPORTANTE: Cambia ADMIN_PASSWORD antes del primer arranque.
ADMIN_USER=admin
ADMIN_PASSWORD=

# CORS: orígenes permitidos (separados por coma).
# En desarrollo se puede dejar vacío (permite todos).
# En producción es OBLIGATORIO: https://tu-dominio.com
CORS_ORIGIN=

# Token para proteger el webhook de WhatsApp (opcional pero recomendado)
WEBHOOK_TOKEN=
